{
  "name": "website-repair-sprint",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types scripts/test/*.test.mjs scripts/test/*.test.ts && npm --prefix tools test",
    "test:browser": "node scripts/test/invoice-browser.mjs",
    "wallet:new": "node scripts/generate-bitcoin-wallet.mjs --force",
    "wallet:status": "node scripts/wallet-status.mjs",
    "audit:site": "node tools/site-preflight.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "bitcoinjs-lib": "7.0.1",
    "next": "16.2.12",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tiny-secp256k1": "2.2.4"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "puppeteer-core": "25.4.0",
    "typescript": "6.0.3"
  }
}
